#include "userprog/syscall.h"
#include "userprog/pagedir.h"
#include <stdio.h>
#include <syscall-nr.h>
#include "threads/interrupt.h"
#include "threads/thread.h"
#include "threads/malloc.h"
#include "devices/input.h"
#include "lib/string.h"

#include "threads/vaddr.h"
#include "threads/synch.h"

#include "filesys/file.h"

#include "filesys/filesys.h"
#include "devices/shutdown.h"

static void syscall_handler (struct intr_frame *);

void test_address(unsigned int *address);
void test_address_range (unsigned int *address, size_t size);

void exit (int status) {
  char *thread = calloc (sizeof (char), strlen (thread_name ()));
  char *save_ptr;
  strlcpy (thread, thread_name (), strlen (thread_name ()) + 1);
  strtok_r (thread, " ", &save_ptr);
  printf("%s: exit(%d)\n", thread, status >= 0 ? status : -1);
  free (thread);
  thread_exit();
}

/* File system synchronization mechanism for P3. */
struct lock file_lock;

void
syscall_init (void) 
{
  intr_register_int (0x30, 3, INTR_ON, syscall_handler, "syscall");
  lock_init(&file_lock);
}

static void
syscall_handler (struct intr_frame *f)
{
  // hex_dump (f->esp, f->esp, 300, true);
  test_address (f->esp);
  unsigned int *esp = (unsigned int *) f->esp;
  unsigned int syscall_num = *esp;

  switch(syscall_num) {

    case SYS_HALT: {
      shutdown_power_off();
    }

    case SYS_EXIT: {
      /* void exit(int status) */

      // terminate the current userprog and return control to kernel
      // return status of child process if parent waits for it
      // 0 status = success, nonzero = error
      // if (!test_address (f->esp + 1)) {
      //   // f->eax = -1;
      //   exit (-1);
      // }
      test_address (esp + 1);
      int status = *(int *)(esp + 1);
      exit (status);
    }

    case SYS_EXEC: {
      test_address (f->esp + 1);
      exit (0);

    }

    case SYS_WAIT: {


    }

    case SYS_CREATE: {
      test_address (f->esp + 1);
      const char *filename = (const char *)*(esp + 1);

      if (!filename || memcmp (filename, "", 1) == 0) {
        exit (-1);
      }

      // still need to implement functionality
      exit (0);
    }

    case SYS_REMOVE: {


    }

    case SYS_OPEN: {
      // Validate the address
      test_address (f->esp + 1);
      const char *filename = (const char *)*(esp + 1);

      if (!filename || memcmp (filename, "", 1) == 0) {
        exit (-1);
      }

      // use lock to prevent two threads opening the same file at once
      lock_acquire(&file_lock);
      struct file *opened_file = filesys_open(filename);
      lock_release(&file_lock);

      if (!opened_file) {
        exit (0);
      }

      struct thread *t = thread_current();

      // return FD starting at 2 but max 128 
      int fd;
      for (fd = 2; fd < 128; fd++) {
        if (!(t->fd_table[fd])) {
          t->fd_table[fd] = opened_file;
          f->eax = fd;  // return FD on success
          exit (0);
        }
      }

      if (fd == 128) {
        // close the file bc we've opened too many already
        lock_acquire(&file_lock);
        file_close(opened_file);
        lock_release(&file_lock);
        exit (-1);
      }
      exit (0);
    }

    case SYS_FILESIZE: {
      // Validate the FD address
      test_address (f->esp + 1);

      int fd = *(int *)(esp + 1);

      // Validate FD
      if (fd < 2 || fd >= 128) {
        exit (-1);
      }

      struct thread *t = thread_current();
      struct file *file_obj = t->fd_table[fd];

      if (!file_obj) {
        exit (-1);
      }

      lock_acquire(&file_lock);
      // f->eax = file_length(file_obj);
      lock_release(&file_lock);
      exit (file_length (file_obj));
    }

    case SYS_READ: {
      /* int read(int fd, void *buffer, unsigned size) */

      /* STACK LAYOUT */
        // [esp + 0] - syscall num
        // [esp + 1] - arg0 (fd)
        // [esp + 2] - arg1 (buffer)
        // [esp + 3] - arg2 (size)

      test_address (esp + 1);
      int fd = *(esp + 1);
      
      test_address (esp + 2);
      char *buffer = (char *) *(esp + 2);
      
      test_address (esp + 3);
      size_t size = *(esp + 3);

      // if (!test_address_range (buffer, size)) {
      //   exit (-1);
      // }

      // Read from STDIN
      if (fd == 0) {
        // Read from keyboard
        // fd=0 reads from keyboard input w/ input_getc()
        // read size bytes from file open as fd into buffer
        char *buf = (char *) buffer;
        for (unsigned i = 0; i < size; i++) {
          buf[i] = (char) input_getc();
        }
        // exit ((int)size);
        f->eax = (int)size;
      }

      struct thread *t = thread_current();

      // Read from a file
      int bytes_read = 0;
      if (fd >= 2 && fd < 128 && t->fd_table[fd] != NULL) {
        lock_acquire(&file_lock);
        bytes_read = file_read(t->fd_table[fd], buffer, size);
        lock_release(&file_lock);

        // exit (bytes_read);
        f->eax = bytes_read;
      }
      return;
    }

    case SYS_WRITE: {
      /* int write(int fd, const void *buffer, unsigned size) */
      test_address (esp + 1);
      int fd = *(esp + 1);
      
      test_address (esp + 2);
      char *buffer = (char *) *(esp + 2);
      if (buffer == NULL) {
        exit (-1);
      }
      
      test_address (esp + 3);
      size_t size = *(esp + 3);
      
      test_address_range ((unsigned int *)buffer, size);
      int bytes_written = 0;
      if (fd == 1) {
        putbuf (buffer, size);
        f->eax = size;
      } else {
        struct thread *t = thread_current();
  
        // Write to a file
        bytes_written = -1;
        if (fd > 1 && fd < 128 && t->fd_table[fd]) {
          if (buffer) {
            lock_acquire(&file_lock);
            bytes_written = file_write(t->fd_table[fd], buffer, size);
            lock_release(&file_lock);
          }
        }
        f->eax = bytes_written;
      }
      return;
    }

    case SYS_SEEK: {
      // Validate the FD address
      test_address (f->esp + 1);

      int fd = *(int *)(esp + 1);

      // Validate the offset address
      test_address (f->esp + 2);

      unsigned offset = *(unsigned *)(esp + 2);

      // Validate FD
      if (fd < 2 || fd >= 128) {
        f->eax = -1;
        exit (-1);
      }

      struct thread *t = thread_current();
      struct file *file_obj = t->fd_table[fd];

      if (!file_obj) {
        f->eax = -1;
        exit (-1);
      }

      lock_acquire(&file_lock);
      file_seek(file_obj, offset);
      lock_release(&file_lock);

      exit (0);
    }

    case SYS_TELL: {
      // Validate the FD address
      test_address (f->esp + 1);

      int fd = *(int *)(esp + 1);

      // Validate FD
      if (fd < 2 || fd >= 128) {
        f->eax = -1;
        exit (-1);
      }

      struct thread *t = thread_current();
      struct file *file_obj = t->fd_table[fd];

      if (!file_obj) {
        f->eax = -1;
        exit (-1);
      }

      lock_acquire(&file_lock);
      f->eax = file_tell(file_obj);
      lock_release(&file_lock);

      exit (0);
    }

    case SYS_CLOSE: {
      // robustness testing for close
      test_address (f->esp + 1);
      int fd = *(esp + 1);
      if (fd == 0 || fd == 1) {
        f->eax = -1;
        exit (-1);
      }

      // still need to check fd table to see if an fd is valid.

      exit (-1);
    }

    default:
      printf("Unsupported syscall %d\n", syscall_num);
      f->eax = -1;
      exit (-1);
  }
}

void test_address (unsigned int *address) {
  if (!address) {
    exit (-1);
  }
  if (!is_user_vaddr (address) || pagedir_get_page (thread_current ()->pagedir, address) == NULL) {
    exit (-1);
  }
}

void test_address_range (unsigned int *address, size_t size) {
  test_address (address);

  uint8_t *addr = (uint8_t *)pg_round_down (address);
  uint8_t *end = (uint8_t *) ((uint8_t *)address + size);

  test_address ((unsigned int *)(end - 1));

  end = (uint8_t *)pg_round_up (end);
  for (; addr < end; addr += 4096) {
    test_address ((unsigned int *)addr);
  }
}